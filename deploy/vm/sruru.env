# /etc/sruru/sruru.env （各ノードで NODE_ID だけ変える。権限 0600, 所有者 sruru）
DATABASE_URL=jdbc:postgresql://10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432/sruru?targetServerType=primary&connectTimeout=3&tcpKeepAlive=true
DATABASE_USER=sruru
DATABASE_PASSWORD=change-me
# 公開 URL（OIDC の issuer・SAML のエンティティ ID になる。後から変えると連携しているアプリの設定もやり直しになる）
PUBLIC_URL=https://id.example.com
STATIC_DIR=/opt/sruru/current/static
HTTP_PORT=8080
# ノード名（ログ・定期処理のリースに使う）
NODE_ID=sruru1
# 署名鍵・外部 IdP のシークレット・TOTP の鍵の暗号化。全ノード共通、16文字以上。変えると保存済みの値を読めなくなる
APP_SECRET=change-me-32-random-chars-same-on-all-nodes
# メール（ワンタイムコード・パスワードの再設定）
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=sruru@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=sruru@example.com
# クライアント証明書を直接受ける場合（HAProxy で TLS を終端するなら不要。ヘッダーで渡す）
#TLS_KEYSTORE=/etc/sruru/keystore.p12
#TLS_KEYSTORE_PASSWORD=change-me
#HTTPS_PORT=8443
